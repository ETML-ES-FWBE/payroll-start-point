@startuml
title Payroll application - class diagram (updated)

package "sequence diagram" {
  class PayrollApplication <<SpringBootApplication>> {
    +PayrollApplication()
    +main(String[])
  }

  class EmployeeController <<RestController>> {
    +EmployeeController(EmployeeRepository)
    +one(Long) : Employee
    +all() : List~Employee~
  }

  interface EmployeeRepository <<Repository>> {
    +findAll()
    +findById(Long)
    +save(Employee)
  }

  class LoadDatabase <<Component\ , CommandLineRunner>> {
    +LoadDatabase()
    +initDatabase(EmployeeRepository) : CommandLineRunner
  }

  class Employee {
    -id : Long
    -name : String
    -role : String
    +Employee(String, String)
    +Employee()
    +equals(Object) : boolean
    +hashCode() : int
    +toString() : String
    +getName() : String
    +getId() : Long
    +getRole() : String
  }

  class EmployeeNotFoundException <<RuntimeException>> {
    +EmployeeNotFoundException(Long)
  }

  class EmployeeNotFoundAdvice <<ControllerAdvice>> {
    +EmployeeNotFoundAdvice()
    +employeeNotFoundHandler(EmployeeNotFoundException) : String
  }

  class EmployeeGetTest {
    +EmployeeGetTest()
    +given_an_existing_employee()
    +when_getting_all_employees_then_success()
    +when_getting_existing_employee_then_success()
  }

  class PayrollApplicationTests {
    +PayrollApplicationTests()
    +contextLoads() : void
  }
}

' Relations
EmployeeController --> EmployeeRepository : repository
EmployeeRepository --> Employee : manages
LoadDatabase --> EmployeeRepository : init / saves sample data
EmployeeNotFoundAdvice --> EmployeeNotFoundException : handles
EmployeeGetTest --> EmployeeRepository : uses
PayrollApplication ..> LoadDatabase : component scanned

@enduml
